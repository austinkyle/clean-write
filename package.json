{
  "name": "cleanwrite",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first writing workspace.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4317",
    "build": "next build",
    "start": "HOSTNAME=127.0.0.1 PORT=4317 node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "drizzle-orm": "^0.45.2",
    "htmlparser2": "^10.1.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.0",
    "openai": "7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
